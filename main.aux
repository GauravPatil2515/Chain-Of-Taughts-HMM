\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cognitive Fingerprint: Transition matrix heatmap ($N=5$ states) visualizing the learned flow of reasoning operations (Start $\rightarrow $ Calculate $\rightarrow $ Conclude). This unsupervised 'Brain Map' reveals that the model follows a structured, sequential logic when reasoning correctly.}}{5}{}\protected@file@percent }
\newlabel{fig:fingerprint}{{3}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Structural Entropy Distribution. Incorrect reasoning chains (red) exhibit significantly higher structural entropy (mean = 0.23) than correct ones (green, mean = 0.14), indicating that 'Confusion' is a measurable signal of hallucination ($p < 0.05$).}}{5}{}\protected@file@percent }
\newlabel{fig:entropy}{{4}{5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Robustness Check: Structural Plausibility vs. Reasoning Length. The near-zero correlation ($r=0.04$) confirms that our metric is difficulty-invariant, fairly scoring both short (easy) and long (hard) problems without length bias.}}{6}{}\protected@file@percent }
\newlabel{fig:difficulty}{{5}{6}{}{}{}}
